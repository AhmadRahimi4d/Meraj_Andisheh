@page "/admin"
@model MerajAndisheh.Web.Areas.Admin.Pages.IndexModel
@{
    ViewData["Title"] = L["Panel.Menu.Home"].Value;
    var sections = AdminMenuCatalog.VisibleFor(User.IsSuperAdmin(), User.GetPermissions())
        .Where(item => item.Id != "home")
        .ToList();
}

<h1>@L["Panel.Home.Welcome", User.FindFirst(AppClaimTypes.DisplayName)?.Value ?? string.Empty]</h1>

@if (sections.Count == 0)
{
    <div class="alert alert--info" role="status">@L["Panel.Home.NoSections"]</div>
}
else
{
    <p>@L["Panel.Home.Intro"]</p>
    <ul class="panel__cards">
        @foreach (var item in sections)
        {
            <li><a class="panel__card" href="@item.Path">@L[item.LabelKey]</a></li>
        }
    </ul>
}
