@page "/account/change-password"
@model MerajAndisheh.Web.Pages.Account.ChangePasswordModel
@using MerajAndisheh.Core.Domain
@{
    ViewData["Title"] = L["Account.Change.Title"].Value;
}

<section class="page-intro auth-card">
    <h1>@L["Account.Change.Title"]</h1>

    @if (Model.MustChange)
    {
        <div class="alert alert--warning" role="status"><span>@L["Account.Change.MustChangeNotice"]</span></div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert--danger" role="alert"></div>
    }

    <form method="post" novalidate>
        <div class="field">
            <label class="field__label" asp-for="Input.CurrentPassword">@L["Account.Change.Current"]</label>
            <input class="field__input" asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
        </div>
        <div class="field">
            <label class="field__label" asp-for="Input.NewPassword">@L["Account.Field.NewPassword"]</label>
            <input class="field__input" asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
            <span class="field__help">@L["Account.Register.PasswordHelp", AccountRules.MinPasswordLength]</span>
        </div>
        <div class="field">
            <label class="field__label" asp-for="Input.ConfirmPassword">@L["Account.Register.ConfirmPassword"]</label>
            <input class="field__input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        </div>

        <button class="btn btn--primary" type="submit">@L["Account.Change.Submit"]</button>
    </form>
</section>
