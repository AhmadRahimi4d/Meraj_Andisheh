@page "/account/forgot-password"
@model MerajAndisheh.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["Account.Forgot.Title"].Value;
}

<section class="page-intro auth-card">
    <h1>@L["Account.Forgot.Title"]</h1>
    <p>@L["Account.Forgot.Description"]</p>

    <form method="post" novalidate>
        <div class="field">
            <label class="field__label" asp-for="Input.Email">@L["Account.Register.Email"]</label>
            <input class="field__input" asp-for="Input.Email" type="email" dir="ltr" autocomplete="email" />
        </div>
        <button class="btn btn--primary" type="submit">@L["Account.Forgot.Submit"]</button>
    </form>

    <ul class="auth-links">
        <li><a asp-page="/Account/Login">@L["Account.Register.LoginLink"]</a></li>
    </ul>
</section>
