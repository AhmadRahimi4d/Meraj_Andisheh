@page "/account/reset-password"
@model MerajAndisheh.Web.Pages.Account.ResetPasswordModel
@using MerajAndisheh.Core.Domain
@{
    ViewData["Title"] = L["Account.Reset.Title"].Value;
}

<section class="page-intro auth-card">
    <h1>@L["Account.Reset.Title"]</h1>

    @if (Model.Done)
    {
        <div class="alert alert--success" role="status"><span>@L["Account.Reset.Success"]</span></div>
        <p><a class="btn btn--primary" asp-page="/Account/Login">@L["Account.Login.Submit"]</a></p>
    }
    else if (Model.LinkInvalid)
    {
        <div class="alert alert--danger" role="alert"><span>@L["Account.Error.TokenInvalid"]</span></div>
        <p><a asp-page="/Account/ForgotPassword">@L["Account.Login.ForgotLink"]</a></p>
    }
    else
    {
        @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert--danger" role="alert"></div>
    }

        <form method="post" novalidate>
            <input type="hidden" asp-for="Input.UserId" />
            <input type="hidden" asp-for="Input.Code" />

            <div class="field">
                <label class="field__label" asp-for="Input.NewPassword">@L["Account.Field.NewPassword"]</label>
                <input class="field__input" asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
                <span class="field__help">@L["Account.Register.PasswordHelp", AccountRules.MinPasswordLength]</span>
            </div>
            <div class="field">
                <label class="field__label" asp-for="Input.ConfirmPassword">@L["Account.Register.ConfirmPassword"]</label>
                <input class="field__input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
            </div>
            <button class="btn btn--primary" type="submit">@L["Account.Reset.Submit"]</button>
        </form>
    }
</section>
